{
	"name": "fdata",
	"version": "0.1.0",
	"description": "Small consumer of @ckirg/corelib-markets: fetch market data from the command line.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.5.2",
	"engines": {
		"node": ">=24"
	},
	"bin": {
		"fdata": "./dist/cli.js"
	},
	"scripts": {
		"dev": "tsx src/cli.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/cli.js",
		"test": "vitest",
		"test:run": "vitest run",
		"typecheck": "tsc --noEmit",
		"format": "biome format . --write",
		"lint": "biome check . --write --max-diagnostics=100",
		"lint:ci": "biome ci .",
		"verify": "pnpm lint:ci && pnpm typecheck && pnpm test:run && pnpm build",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"@ckirg/corelib-markets": "^0.3.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^25.9.2",
		"lefthook": "^2.2.2",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11"
	}
}
